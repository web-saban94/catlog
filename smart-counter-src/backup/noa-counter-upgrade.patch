+      repMessage: String(d?.repMessage || "").slice(0, 2000),
+      turns: Array.isArray(d?.turns) ? d.turns.slice(-20) : [],
+    }),
+  )
+  .handler(async ({ data }) => {
+    const scenario =
+      (data.scenarioId && SIMULATION_SCENARIOS.find((s) => s.id === data.scenarioId)) ||
+      detectSimulationScenario(data.promptHint || data.repMessage);
+
+    if (data.action === "start") {
+      return {
+        scenarioId: scenario.id,
+        title: scenario.title,
+        customerMessage: scenario.openingCustomerLine,
+        hintForRep: scenario.repHint,
+        turnCount: 0,
+      };
+    }
+
+    if (data.action === "evaluate") {
+      const evaluation = evaluateSimulationSession(data.turns, scenario.id);
+      return {
+        scenarioId: scenario.id,
+        title: scenario.title,
+        customerMessage: "",
+        hintForRep: "",
+        turnCount: data.turns.length,
+        evaluation,
+      };
+    }
+
+    const repCount = data.turns.filter((t) => t.role === "rep").length + 1;
+    const reply = generateCustomerSimulationTurn({
+      scenarioId: scenario.id,
+      repMessage: data.repMessage,
+      turnNumber: repCount,
+    });
+    return {
+      scenarioId: scenario.id,
+      title: scenario.title,
+      customerMessage: reply.customerMessage,
+      hintForRep: reply.hintForRep,
+      turnCount: repCount,
+    };
+  });
+
+export const getTrainingCatalogFn = createServerFn({ method: "GET" })
+  .inputValidator((d?: { category?: string }) => ({
+    category: d?.category ? String(d.category) : undefined,
+  }))
+  .handler(async ({ data }) => {
+    return {
+      resources: getTrainingResourcesByCategory(data?.category),
+    };
+  });
