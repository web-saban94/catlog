+const PROMPT_INJECTION_PATTERNS = [
+  /ignore\s+(all\s+)?previous\s+instructions/gi,
+  /system\s*prompt/gi,
+  /you\s+are\s+now/gi,
+  /התעלם\s+מהוראות/gi,
+  /הנחיות\s+מערכת/gi,
+  /jailbreak/gi,
+];
+
+/** מנטרל ניסיונות prompt injection ממסמכים חיצוניים */
+export function sanitizeUntrustedDocumentText(raw: string, maxLen = 2400): string {
+  let clean = String(raw || "")
+    .replace(/<script[\s\S]*?<\/script>/gi, " ")
+    .replace(/<style[\s\S]*?<\/style>/gi, " ")
+    .replace(/<[^>]+>/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+
+  for (const re of PROMPT_INJECTION_PATTERNS) {
+    clean = clean.replace(re, "[תוכן חיצוני מסונן]");
+  }
+  return clean.slice(0, maxLen);
+}
+
+/** מניעת SSRF בעת שליפת כתובות techUrl מהגיליון */
+export function isSafePublicUrl(rawUrl: string): boolean {
+  try {
+    const parsed = new URL(rawUrl);
+    if (parsed.protocol !== "https:" && parsed.protocol !== "http:") return false;
+    const host = parsed.hostname.toLowerCase();
+    if (
+      host === "localhost" ||
+      host === "127.0.0.1" ||
+      host === "0.0.0.0" ||
+      host === "::1" ||
+      host === "169.254.169.254" ||
+      host.startsWith("10.") ||
+      host.startsWith("192.168.") ||
+      /^172\.(1[6-9]|2\d|3[0-1])\./.test(host) ||
+      host.endsWith(".local") ||
+      host.endsWith(".internal")
+    ) {
+      return false;
+    }
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+export async function fetchVerifiedTechUrlSnippet(url: string): Promise<string> {
+  if (!isSafePublicUrl(url)) return "";
+  try {
+    const res = await fetch(url, {
+      redirect: "follow",
+      signal: AbortSignal.timeout(8_000),
+      headers: {
+        "User-Agent": "SabanKnowledgeEngine/2.0",
+        Accept: "text/html,application/xhtml+xml,text/plain",
+      },
+    });
+    if (!res.ok) return "";
+    const contentType = res.headers.get("content-type") || "";
+    if (!/text|html|json|xml/i.test(contentType)) return "";
+    const body = await res.text();
+    return sanitizeUntrustedDocumentText(body, 2200);
+  } catch {
+    return "";
+  }
+}
